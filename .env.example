# auth-gateway configuration (copy to .env and adjust)

# Full URLs of the two oauth2-proxy backends (required).
BACKEND_PRIMARY=http://localhost:4180
BACKEND_SECONDARY=http://localhost:4181

# Address the gateway listens on (default :8080).
LISTEN_ADDR=:8080

# Name of the routing cookie (default auth_mode).
COOKIE_NAME=auth_mode

# Custom selector page (optional, mutually exclusive — setting both is fatal).
# Either is a *shell*: one self-contained HTML document containing
# <!--AUTH_GATEWAY_SELECTOR--> exactly once, where the gateway splices in the
# selector widget it owns. See README: "Custom selector page".
# SELECTOR_HTML_FILE=/etc/auth-gateway/selector.html
# SELECTOR_HTML=<!doctype html><html><body><!--AUTH_GATEWAY_SELECTOR--></body></html>
